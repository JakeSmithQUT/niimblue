{
  "name": "niimbot-unlocked",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "vite --config vite.electron.config.ts",
    "build:renderer": "vite build --config vite.electron.config.ts",
    "build:main": "node build-main.mjs",
    "package": "npm run build:renderer && npm run build:main && electron-builder --config electron-builder.yml",
    "start": "npm run build:main && electron .",
    "sv-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format-all": "prettier --write \"src/**/*.{ts,svelte}\" \"electron/**/*.ts\""
  },
  "dependencies": {
    "@mmote/niimbluelib": "0.0.1-alpha.42",
    "d3-dsv": "^3.0.1",
    "qrcode-generator": "2.0.4",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^24.13.2",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.5"
  }
}
